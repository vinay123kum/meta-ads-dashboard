# Copy this file to  .env  and fill in real values. NEVER commit .env.

# --- Meta Marketing API ---
# From your Meta Developer App (developers.facebook.com -> your app -> Settings -> Basic)
META_APP_ID=
META_APP_SECRET=

# A USER access token from your FB profile (Graph API Explorer or your OAuth flow).
# Scopes needed: ads_read, ads_management, business_management, read_insights.
# User tokens last ~60 days — extend to a long-lived token, refresh before expiry.
# Later: replace with an agency-BM System User token (non-expiring) for production.
META_ACCESS_TOKEN=

# Optional: comma-separated allowlist to limit which accounts the tools touch.
# e.g. act_1234567890,act_9876543210   (leave blank to auto-discover all)
META_ACCOUNT_ALLOWLIST=

# --- Database (Phase 1+) ---
# Supabase: Project Settings -> Database -> Connection string (URI)
DATABASE_URL=

# --- Phase 2: scheduling + alerts ---
# SYNC_HOUR: daily auto-sync hour (0-23, local time)
SYNC_HOUR=6
# SLACK_WEBHOOK_URL: optional Slack incoming webhook to push alerts
SLACK_WEBHOOK_URL=
